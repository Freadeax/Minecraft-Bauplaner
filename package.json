{
  "name": "minecraft-bauplaner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "build": "npm run build:core && npm run build:web",
    "test": "node --test tests/*.test.mjs",
    "check:docs": "python3 scripts/check_docs.py",
    "check": "npm run typecheck && npm run build && npm test && npm run check:docs",
    "build:core": "tsc",
    "build:web": "node scripts/clean_pages.mjs && vite build && node scripts/prepare_pages.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  }
}
