{
  "name": "minecraft-bauplaner",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "build": "npm run build:core && npm run build:web",
    "test": "node --test tests/*.test.mjs",
    "check:docs": "node scripts/python.mjs scripts/check_docs.py",
    "check:testplan": "node scripts/render_testplan.mjs --check",
    "check:library": "node scripts/library_intake.mjs check",
    "testplan:render": "node scripts/render_testplan.mjs",
    "library:add": "npm run build:core && node scripts/library_intake.mjs add",
    "library:remove": "npm run build:core && node scripts/library_intake.mjs remove",
    "library:list": "node scripts/library_intake.mjs list",
    "check": "npm run check:architecture && npm run check:roadmap && npm run typecheck && npm run build && npm test && npm run check:docs && npm run check:testplan && npm run check:library",
    "build:core": "tsc",
    "build:web": "node scripts/clean_pages.mjs && vite build && node scripts/build_catalog_snapshot.mjs && node scripts/prepare_pages.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "check:architecture": "node scripts/check_architecture.mjs",
    "format:check-schem": "npm run build:core && node scripts/check_schem_roundtrip.mjs",
    "check:roadmap": "node scripts/roadmap.mjs check",
    "check:roadmap-change": "node scripts/roadmap.mjs check-change",
    "roadmap:render": "node scripts/roadmap.mjs render",
    "roadmap:record": "node scripts/roadmap.mjs record",
    "setup:hooks": "git config core.hooksPath .githooks",
    "setup:codex": "node scripts/setup_codex.mjs",
    "setup:browser": "playwright install chromium"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  }
}
