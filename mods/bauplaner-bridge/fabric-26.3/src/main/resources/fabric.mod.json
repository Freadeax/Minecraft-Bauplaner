{
  "schemaVersion": 1,
  "id": "bauplaner_bridge",
  "version": "${version}",
  "name": "LMNT — Build Studio Bridge",
  "description": "Build-Studio-Pläne als Hologramm mit Live-Abgleich, Materialliste und Platzierhilfe, dazu die Aufnahme für LMNT — Build Studio. Nur Client, baut nie selbst.",
  "authors": ["Freadeax"],
  "contact": { "homepage": "https://freadeax.github.io/Minecraft-Bauplaner/", "sources": "https://github.com/Freadeax/Minecraft-Bauplaner" },
  "license": "MIT",
  "environment": "client",
  "entrypoints": { "client": ["io.github.freadeax.bauplaner.bridge.fabric.BridgeClient"] },
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "~${minecraft}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
